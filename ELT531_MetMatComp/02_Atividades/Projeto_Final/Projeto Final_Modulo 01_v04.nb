         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"TemplateApply", "[", 
             RowBox[{"\"\<``\>\"", ",", "tagOS"}], "]"}], "==", "\"\<L\>\""}],
