Cell["\<\
where the \[OpenCurlyDoubleQuote]AverRefTimeInterval\[CloseCurlyDoubleQuote] \
is the average reference time interval.\
\>", "Text",
 CellChangeTimes->{{3.985295895301399*^9, 3.9852959350191135`*^9}, {
  3.9852960178849106`*^9, 3.985296061644663*^9}},
