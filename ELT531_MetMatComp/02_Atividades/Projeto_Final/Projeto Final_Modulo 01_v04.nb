Cell[TextData[{
 Cell[BoxData[
  FormBox[
   OverscriptBox["\[Psi]", "."], TraditionalForm]],
  FontSlant->"Italic",ExpressionUUID->"c0ef9b75-d9de-c048-a5c3-7eeb766fa8fc"],
 StyleBox["(k) = [\[Psi](k) \[Minus] \[Psi](k\[Minus]1)]/\[CapitalDelta]t = \
\[Omega]",
  FontSlant->"Italic"],
 " , "
}], "Text",
 CellChangeTimes->{
  3.9850332878540154`*^9, {3.9850333320733185`*^9, 3.985033437258486*^9}},
 TextAlignment->Center,
 FontFamily->"Bookman Old Style",
