      RowBox[{"\"\<Sample1\>\"", ",", "\"\<\[CapitalDelta]t\>\""}], "}"}]}], ",", 
    RowBox[{"PlotLabel", "->", "\"\<\[CapitalDelta]t = t(n) - t(n-1)\>\""}], ",",
