            RowBox[{"All", ",", "1"}], "]"}], "]"}], "[", 
          RowBox[{"[", "n", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"fnew", "=", 
         RowBox[{"RightRectIntV3", "[", 
          RowBox[{
           RowBox[{"dts", "[", 
            RowBox[{"[", 
             RowBox[{"1", ";;", "n"}], "]"}], "]"}], ",", "intervalType"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"sollist", "=", 
         RowBox[{"Append", "[", 
          RowBox[{"sollist", ",", 
           RowBox[{"{", 
            RowBox[{"tnew", ",", "fnew"}], "}"}]}], "]"}]}], ";", 
        RowBox[{"(*", 
         RowBox[{"Mounting", " ", "the", " ", "result", " ", "vector"}], 
         "*)"}], "\[IndentingNewLine]", 
        RowBox[{"n", " ", "=", " ", 
         RowBox[{"n", "+", "1"}]}]}], ",", 
       RowBox[{"{", "steps", "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Return", "[", "sollist", "]"}]}]}], " ", 
   RowBox[{"(*", 
    RowBox[{"to", " ", "see", " ", "all", " ", "grid", " ", "points"}], 
    "*)"}], "]"}]}]], "Input",
