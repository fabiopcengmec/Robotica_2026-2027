Cell[TextData[{
 "Com essas equa\[CCedilla]\[OTilde]es, \[EAcute] poss\[IAcute]vel estimar o \
movimento do rob\[OHat] a partir dos dados de velocidade medidos por encoders \
instalados nas rodas.\n\nO modelo cinem\[AAcute]tico de um rob\[OHat] do tipo \
uniciclo com deslocamento do ponto de controle \[OpenCurlyDoubleQuote]",
 StyleBox["h",
  FontSlant->"Italic"],
 "\[CloseCurlyDoubleQuote] \[EAcute] dado por:"
}], "Text",
 CellChangeTimes->{{3.9850324908351784`*^9, 3.9850325261433372`*^9}, {
  3.9850325681682415`*^9, 3.9850325766338425`*^9}, {3.985033895312372*^9, 
  3.985033897016409*^9}, {3.9850343662315826`*^9, 3.985034367248205*^9}},
 FontFamily->"Bookman Old Style",
 FontWeight->"Light",ExpressionUUID->"14816327-bc64-2e47-8491-e0a6414bd883"],

