 TextAlignment->Center,
 FontFamily->"Bookman Old Style",
 FontWeight->"Normal",ExpressionUUID->"16245396-f0c0-453d-9ef0-ef75fca7e3a6"],

Cell[TextData[{
 "The \[OpenCurlyDoubleQuote]",
 StyleBox["u",
  FontSlant->"Italic"],
 "\[CloseCurlyDoubleQuote] and \[OpenCurlyDoubleQuote]\[Omega]\
\[CloseCurlyDoubleQuote] signals can be organizing in a \
\[OpenCurlyDoubleQuote]",
 StyleBox["u\[Omega]signals",
  FontSlant->"Italic"],
 "\[CloseCurlyDoubleQuote] matrix. So:"
}], "Text",
 CellChangeTimes->{{3.985466693927952*^9, 3.9854667922928085`*^9}, {
