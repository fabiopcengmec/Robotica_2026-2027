Cell[BoxData[
 RowBox[{
  RowBox[{"IntEulerV13", "[", 
   RowBox[{"dataset_", ",", "initialValues_"}], "]"}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"t0", "=", 
       RowBox[{"initialValues", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ",", 
      RowBox[{"f0", "=", 
       RowBox[{"initialValues", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], ",", 
      RowBox[{"sollist", "=", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"initialValues", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", 
          RowBox[{"initialValues", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], "}"}], "}"}]}], ",", 
      RowBox[{"tf", "=", 
       RowBox[{
        RowBox[{"dataset", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "1"}], "]"}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"-", "1"}], "]"}], "]"}]}], ",", 
      RowBox[{"dts", "=", "dataset"}], ",", 
      RowBox[{"n", "=", "2"}], ",", 
      RowBox[{"ff", "=", 
       RowBox[{
        RowBox[{"dataset", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "2"}], "]"}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"-", "1"}], "]"}], "]"}]}], ",", "tn", ",", "fn", ",", 
      "told", ",", "fold", ",", "steps", ",", "h", ",", "tnew", ",", "fnew"}],
      "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"h", "=", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"tn", "-", "t0"}], ")"}], "/", "steps"}], "]"}]}], ";"}], 
     "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"h", "=", 
      RowBox[{"N", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"tf", "-", "t0"}], ")"}], "/", 
        RowBox[{"Length", "[", 
         RowBox[{"dts", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"steps", "=", 
      RowBox[{
       RowBox[{"Length", "[", 
        RowBox[{"dts", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}], "-", "1"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"told", "=", "t0"}], ";", "\[IndentingNewLine]", 
     RowBox[{"fold", "=", "f0"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"tn", ";", "\[IndentingNewLine]", "fn", ";"}], 
      "\[IndentingNewLine]", "*)"}], 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"tnew", " ", "=", " ", 
         RowBox[{"dts", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{"n", "-", "1"}], ",", "1"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"fnew", " ", "=", " ", 
         RowBox[{
          RowBox[{"sollist", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"n", "-", "1"}], ",", "2"}], "]"}], "]"}], "+", 
          RowBox[{
           RowBox[{"dts", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"n", "-", "1"}], ",", "2"}], "]"}], "]"}], " ", 
           RowBox[{"(", 
            RowBox[{"tnew", "-", "told"}], ")"}]}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"sollist", "=", 
         RowBox[{"Append", "[", 
          RowBox[{"sollist", ",", 
           RowBox[{"{", 
            RowBox[{"tnew", ",", "fnew"}], "}"}]}], "]"}]}], ";", 
        RowBox[{"(*", 
         RowBox[{"Mounting", " ", "the", " ", "result", " ", "vector"}], 
         "*)"}], "\[IndentingNewLine]", 
        RowBox[{"told", "=", "tnew"}], ";", "\[IndentingNewLine]", 
        RowBox[{"n", " ", "=", " ", 
         RowBox[{"n", "+", "1"}]}]}], "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"tnew", "=", 
          RowBox[{"told", "+", "h"}]}], ";", 
         RowBox[{"(*", 
          RowBox[{"\"\<FOR\>\"", " ", "to", " ", "Wolfram", " ", "Language"}],
           "*)"}], "\[IndentingNewLine]", 
         RowBox[{"fnew", "=", 
          RowBox[{"fold", "+", 
           RowBox[{"h", "*", 
            RowBox[{"dataset", "[", 
             RowBox[{"[", 
              RowBox[{"n", ",", "2"}], "]"}], "]"}]}]}]}], ";"}], 
        "\[IndentingNewLine]", "*)"}], 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"tnew", "=", "tn"}], ";", 
         RowBox[{"(*", 
          RowBox[{"\"\<FOR\>\"", " ", "to", " ", "Wolfram", " ", "Language"}],
           "*)"}], "\[IndentingNewLine]", 
         RowBox[{"fnew", "=", 
          RowBox[{"fn", "+", 
           RowBox[{"h", "*", 
            RowBox[{"dataset", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"n", "-", "1"}], ",", "2"}], "]"}], "]"}]}]}]}], ";"}],
         "*)"}], "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"told", "=", "tnew"}], ";", "\[IndentingNewLine]", 
         RowBox[{"fold", "=", "fnew"}]}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"tn", "=", "tnew"}], ";", "\[IndentingNewLine]", 
         RowBox[{"fn", "=", "fnew"}]}], "*)"}], ",", 
       RowBox[{"{", "steps", "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Return", "[", "sollist", "]"}]}]}], " ", 
   RowBox[{"(*", 
    RowBox[{"to", " ", "see", " ", "all", " ", "grid", " ", "points"}], 
    "*)"}], "]"}]}]], "Input",
