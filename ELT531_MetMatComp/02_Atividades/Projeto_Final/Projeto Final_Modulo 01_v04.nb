Cell[TextData[{
 "1. Realize a leitura do arquivo de dados \[OpenCurlyDoubleQuote]",
 StyleBox["wRwL.txt",
  FontSlant->"Italic"],
 "\[CloseCurlyDoubleQuote], o qual possui 400 linhas e 3 colunas. Em outras \
palavras, o arquivo cont\[EAcute]m 400 medidas de tempo, velocidade da roda \
direita \[OpenCurlyDoubleQuote]",
 StyleBox["\[Omega]R",
  FontSlant->"Italic"],
 "\[CloseCurlyDoubleQuote] e velocidade da roda esquerda \
\[OpenCurlyDoubleQuote]",
 StyleBox["\[Omega]L",
  FontSlant->"Italic"],
 "\[CloseCurlyDoubleQuote]."
}], "Text",
