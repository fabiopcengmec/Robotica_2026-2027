Cell[BoxData[
 RowBox[{
  RowBox[{"\[Psi]v2", "[", 
   RowBox[{"time_", ",", "psiinicial_"}], "]"}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"t", "=", "time"}], ",", 
      RowBox[{"psi0", "=", "psiinicial"}], ",", " ", 
      RowBox[{"sollist", "=", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"0", ",", "psiinicial"}], "}"}], "}"}]}], ",", 
      RowBox[{"omega", "=", 
       RowBox[{"\[Omega]signal", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ",", "psitemp", ",", 
      RowBox[{"nold", "=", "1"}], ",", "nnew", ",", "steps"}], "}"}], ",", 
    "\n", 
    RowBox[{
     RowBox[{"steps", " ", "=", " ", 
      RowBox[{
       RowBox[{"Length", "[", "t", "]"}], "-", "1"}]}], ";", "\n", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"nnew", "=", 
         RowBox[{"nold", "+", "1"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"psitemp", " ", "=", " ", 
         RowBox[{
          RowBox[{"sollist", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"nnew", "-", "1"}], ",", "2"}], "]"}], "]"}], "+", 
          RowBox[{
           RowBox[{"omega", "[", 
            RowBox[{"[", "nnew", "]"}], "]"}], " ", 
           RowBox[{"\[CapitalDelta]t", "[", "nnew", "]"}]}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"sollist", " ", "=", " ", 
         RowBox[{"Append", "[", 
          RowBox[{"sollist", ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"t", "[", 
              RowBox[{"[", "nold", "]"}], "]"}], ",", "psitemp"}], "}"}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"nold", "=", "nnew"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"nnew", "=", "steps"}], "}"}]}], "\[IndentingNewLine]", "]"}],
      ";", "\n", 
     RowBox[{"Return", "[", "sollist", "]"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.985293491854433*^9, 3.9852935060111465`*^9}, {
