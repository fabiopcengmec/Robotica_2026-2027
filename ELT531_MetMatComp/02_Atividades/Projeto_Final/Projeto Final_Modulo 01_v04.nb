Cell[TextData[{
 "6. Para demonstrar a evolu\[CCedilla]\[ATilde]o temporal da posi\[CCedilla]\
\[ATilde]o e orienta\[CCedilla]\[ATilde]o do rob\[OHat], plote os \
gr\[AAcute]ficos que relaciona o \[OpenCurlyDoubleQuote]",
 StyleBox["tempo",
  FontSlant->"Italic"],
 " x ",
 StyleBox["x",
  FontSlant->"Italic"],
 "\[CloseCurlyDoubleQuote] e o \[OpenCurlyDoubleQuote]",
 StyleBox["tempo",
  FontSlant->"Italic"],
 " x ",
 StyleBox["y",
  FontSlant->"Italic"],
 "\[CloseCurlyDoubleQuote], o \[OpenCurlyDoubleQuote]",
 StyleBox["tempo",
  FontSlant->"Italic"],
 " x ",
 StyleBox["\[Psi]",
  FontSlant->"Italic"],
 "\[CloseCurlyDoubleQuote]."
}], "Text",
