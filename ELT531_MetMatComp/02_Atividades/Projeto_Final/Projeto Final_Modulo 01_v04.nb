Cell[BoxData[
 RowBox[{
  RowBox[{"integrateFunctionTrap", "[", 
   RowBox[{"dataset_", ",", "initialValues_", ",", "intervalType_"}], "]"}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"t0", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", 
           RowBox[{"Dimensions", "[", "dataset", "]"}], "]"}], "==", "2"}], ",", 
         RowBox[{"initialValues", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], ",", 
      RowBox[{"f0", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", 
           RowBox[{"Dimensions", "[", "dataset", "]"}], "]"}], "==", "2"}], ",", 
         RowBox[{"initialValues", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], ",", 
      RowBox[{"sollist", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", 
           RowBox[{"Dimensions", "[", "dataset", "]"}], "]"}], "==", "2"}], ",", 
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"initialValues", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", 
            RowBox[{"initialValues", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], "}"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"initialValues", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "}"}]}], "]"}]}], ",", 
      RowBox[{"tf", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", 
           RowBox[{"Dimensions", "[", "dataset", "]"}], "]"}], "==", "2"}], ",", 
         RowBox[{
          RowBox[{"dataset", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "1"}], "]"}], "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"-", "1"}], "]"}], "]"}]}], "]"}]}], ",", 
      RowBox[{"ff", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", 
           RowBox[{"Dimensions", "[", "dataset", "]"}], "]"}], "==", "2"}], ",", 
         RowBox[{
          RowBox[{"dataset", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "2"}], "]"}], "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"-", "1"}], "]"}], "]"}], ",", 
         RowBox[{"dataset", "[", 
          RowBox[{"[", 
           RowBox[{"-", "1"}], "]"}], "]"}]}], "]"}]}], ",", 
      RowBox[{"dts", "=", "dataset"}], ",", 
      RowBox[{"n", "=", "2"}], ",", "tn", ",", "fn", ",", "told", ",", "fold",
       ",", "steps", ",", "h", ",", "tnew", ",", "fnew"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"steps", "=", 
      RowBox[{
       RowBox[{"Length", "[", 
        RowBox[{"dts", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}], "-", "1"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"told", "=", "t0"}], ";", "\[IndentingNewLine]", 
       RowBox[{"fold", "=", "f0"}], ";"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"tnew", "=", 
         RowBox[{
          RowBox[{"dts", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "1"}], "]"}], "]"}], "[", 
          RowBox[{"[", "n", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"fnew", "=", 
         RowBox[{"TrapIntV11", "[", 
          RowBox[{
           RowBox[{"dts", "[", 
            RowBox[{"[", 
             RowBox[{"1", ";;", "n"}], "]"}], "]"}], ",", "intervalType"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"sollist", "=", 
         RowBox[{"Append", "[", 
          RowBox[{"sollist", ",", 
           RowBox[{"{", 
            RowBox[{"tnew", ",", "fnew"}], "}"}]}], "]"}]}], ";", 
        RowBox[{"(*", 
         RowBox[{"Mounting", " ", "the", " ", "result", " ", "vector"}], 
         "*)"}], "\[IndentingNewLine]", 
        RowBox[{"n", " ", "=", " ", 
         RowBox[{"n", "+", "1"}]}]}], ",", 
       RowBox[{"{", "steps", "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Return", "[", "sollist", "]"}]}]}], " ", 
   RowBox[{"(*", 
    RowBox[{"to", " ", "see", " ", "all", " ", "grid", " ", "points"}], 
    "*)"}], "]"}]}]], "Input",
