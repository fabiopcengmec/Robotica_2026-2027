Cell[BoxData[
 RowBox[{
  RowBox[{"OhErrorType1", "[", 
   RowBox[{"dataset_", ",", "TypeSolution_"}], 
   RowBox[{"(*", 
    RowBox[{"\"\<P\>\"", "artials", " ", "or", " ", "\"\<T\>\"", "otal"}], 
    "*)"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"sollist", "=", 
       RowBox[{"{", "0", "}"}]}], ",", 
      RowBox[{"i", "=", "1"}], ",", "error", ",", "steps"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", 
         RowBox[{"Dimensions", "[", "dataset", "]"}], "]"}], "==", "1"}], ",", 
       RowBox[{"steps", "=", 
        RowBox[{"Length", "[", "dataset", "]"}]}], ",", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", 
           RowBox[{"Dimensions", "[", "dataset", "]"}], "]"}], "==", "2"}], ",", 
         RowBox[{"steps", "=", 
          RowBox[{"Length", "[", 
           RowBox[{"dataset", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}]}], "]"}]}], 
      "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", 
            RowBox[{"Dimensions", "[", "dataset", "]"}], "]"}], "==", "1"}], ",", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"TypeSolution", "==", "\"\<P\>\""}], ",", 
            RowBox[{"error", "=", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"dataset", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", "+", "1"}], "]"}], "]"}], "-", 
                RowBox[{"dataset", "[", 
                 RowBox[{"[", "i", "]"}], "]"}]}], ")"}], "/", "2"}]}], ",", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"TypeSolution", "==", "\"\<T\>\""}], ",", 
              RowBox[{"error", "=", 
               RowBox[{"Sum", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"dataset", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", "+", "1"}], "]"}], "]"}], "-", 
                    RowBox[{"dataset", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], ")"}], "/", "2"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"n", ",", "i"}], "}"}]}], "]"}]}]}], "]"}]}], 
           "]"}]}], "]"}], ";", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"sollist", "=", 
           RowBox[{"Append", "[", 
            RowBox[{"sollist", ",", "error"}], "]"}]}], ";", 
          RowBox[{"i", "=", 
           RowBox[{"i", "+", "1"}]}], " ", 
          RowBox[{"(*", 
           RowBox[{
           "If", " ", "the", " ", "interval", " ", "is", " ", "unitary", " ", 
            "or", " ", "not", " ", "specified"}], "*)"}], ";"}], "*)"}], 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", 
            RowBox[{"Dimensions", "[", "dataset", "]"}], "]"}], "==", "2"}], ",", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"TypeSolution", "==", "\"\<P\>\""}], ",", 
            RowBox[{"error", "=", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"1", "/", "2"}], ")"}], " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"dataset", "[", 
                   RowBox[{"[", 
                    RowBox[{
                    RowBox[{"i", "+", "1"}], ",", "1"}], "]"}], "]"}], "-", 
                  RowBox[{"dataset", "[", 
                   RowBox[{"[", 
                    RowBox[{"i", ",", "1"}], "]"}], "]"}]}], ")"}], "^", 
                "2"}], ")"}], 
              RowBox[{"(", 
               FractionBox[
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"dataset", "[", 
                   RowBox[{"[", 
                    RowBox[{
                    RowBox[{"i", "+", "1"}], ",", "2"}], "]"}], "]"}], "-", 
                  RowBox[{"dataset", "[", 
                   RowBox[{"[", 
                    RowBox[{"i", ",", "2"}], "]"}], "]"}]}], ")"}], 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"dataset", "[", 
                   RowBox[{"[", 
                    RowBox[{
                    RowBox[{"i", "+", "1"}], ",", "1"}], "]"}], "]"}], "-", 
                  RowBox[{"dataset", "[", 
                   RowBox[{"[", 
                    RowBox[{"i", ",", "1"}], "]"}], "]"}]}], ")"}]], 
               ")"}]}]}], ",", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"TypeSolution", "==", "\"\<T\>\""}], ",", 
              RowBox[{"error", "=", 
               RowBox[{"Sum", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"1", "/", "2"}], ")"}], " ", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"dataset", "[", 
                    RowBox[{"[", 
                    RowBox[{
                    RowBox[{"i", "+", "1"}], ",", "1"}], "]"}], "]"}], "-", 
                    RowBox[{"dataset", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "1"}], "]"}], "]"}]}], ")"}], "^", 
                    "2"}], ")"}], 
                  RowBox[{"(", 
                   FractionBox[
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"dataset", "[", 
                    RowBox[{"[", 
                    RowBox[{
                    RowBox[{"i", "+", "1"}], ",", "2"}], "]"}], "]"}], "-", 
                    RowBox[{"dataset", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "2"}], "]"}], "]"}]}], ")"}], 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"dataset", "[", 
                    RowBox[{"[", 
                    RowBox[{
                    RowBox[{"i", "+", "1"}], ",", "1"}], "]"}], "]"}], "-", 
                    RowBox[{"dataset", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "1"}], "]"}], "]"}]}], ")"}]], ")"}]}], 
                 ",", 
                 RowBox[{"{", 
                  RowBox[{"n", ",", "i"}], "}"}]}], "]"}]}]}], "]"}]}], 
           "]"}]}], "]"}], ";", 
        RowBox[{"sollist", "=", 
         RowBox[{"Append", "[", 
          RowBox[{"sollist", ",", "error"}], "]"}]}], ";", 
        RowBox[{"i", "=", 
         RowBox[{"i", "+", "1"}]}]}], 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"If", " ", "the", " ", "interval", " ", "Xi"}], "+", "1", 
         " ", "-", " ", 
         RowBox[{"Xi", " ", "is", " ", "constant"}]}], "*)"}], 
       "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
        RowBox[{"steps", "-", "1"}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Return", "[", "sollist", "]"}]}]}], " ", 
   RowBox[{"(*", 
    RowBox[{"to", " ", "see", " ", "all", " ", "grid", " ", "points"}], 
    "*)"}], "]"}]}]], "Input",
