Cell[BoxData[
 RowBox[{
  RowBox[{"integrateFunctionRightRect", "[", 
   RowBox[{"dataset_", ",", "initialValues_", ",", "intervalType_"}], "]"}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"t0", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", 
           RowBox[{"Dimensions", "[", "dataset", "]"}], "]"}], "==", "2"}], ",", 
         RowBox[{"initialValues", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], ",", 
      RowBox[{"f0", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", 
           RowBox[{"Dimensions", "[", "dataset", "]"}], "]"}], "==", "2"}], ",", 
         RowBox[{"initialValues", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], ",", 
      RowBox[{"sollist", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", 
           RowBox[{"Dimensions", "[", "dataset", "]"}], "]"}], "==", "2"}], ",", 
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"initialValues", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", 
            RowBox[{"initialValues", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], "}"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"initialValues", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "}"}]}], "]"}]}], ",", 
      RowBox[{"tf", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", 
           RowBox[{"Dimensions", "[", "dataset", "]"}], "]"}], "==", "2"}], ",", 
         RowBox[{
          RowBox[{"dataset", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "1"}], "]"}], "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"-", "1"}], "]"}], "]"}]}], "]"}]}], ",", 
      RowBox[{"ff", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", 
