     RowBox[{"usar", " ", "'"}], 
     RowBox[{
      RowBox[{"time", "'"}], "."}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"toPairs", "[", "data_", "]"}], " ", ":=", " ", 
     RowBox[{"Which", "[", "\n", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{"MatrixQ", "[", 
         RowBox[{"data", ",", " ", "NumericQ"}], "]"}], " ", "&&", " ", 
        RowBox[{
         RowBox[{"Last", "[", 
          RowBox[{"Dimensions", "[", "data", "]"}], "]"}], " ", "==", " ", 
         "2"}]}], ",", " ", "data", ",", "\n", "  ", 
