Cell[CellGroupData[{

Cell[TextData[{
 "2.2 - Calculating and verifying the \[OpenCurlyDoubleQuote]",
 StyleBox["u",
  FontSlant->"Italic"],
 "\[CloseCurlyDoubleQuote] and \[OpenCurlyDoubleQuote]",
 StyleBox["v",
  FontSlant->"Italic"],
 "\[CloseCurlyDoubleQuote] control signals:"
}], "Section",
 CellFrame->{{6, 0}, {0, 1}},
 CellChangeTimes->{{3.512208450234375*^9, 3.512208551265625*^9}, {
   3.51220858384375*^9, 3.51220858459375*^9}, {3.5122086178125*^9, 
