Cell["ou ainda:", "Text",
 CellChangeTimes->{
  3.9850332878540154`*^9, {3.9850333320733185`*^9, 3.9850334298793373`*^9}, {
   3.985033661256199*^9, 3.9850336700076466`*^9}, {3.9850337032317295`*^9, 
   3.9850337290472317`*^9}},
 FontFamily->"Bookman Old Style",
 FontWeight->"Light",ExpressionUUID->"c240131d-22b8-aa43-9049-d887363c8960"],

Cell[TextData[{
 StyleBox["\[Psi](k) = \[Psi](k\[Minus]1) + \[Omega]\[CapitalDelta]t",
  FontSlant->"Italic"],
 " ."
}], "Text",
 CellChangeTimes->{
  3.9850332878540154`*^9, {3.9850333320733185`*^9, 3.9850334298793373`*^9}, {
   3.985033661256199*^9, 3.9850336700076466`*^9}, {3.9850337032317295`*^9, 
   3.985033725656973*^9}},
 TextAlignment->Center,
 FontFamily->"Bookman Old Style",
 FontWeight->"Light",ExpressionUUID->"b7f4cc51-5c4e-d84b-b1dd-704a61b2c5dd"],

Cell[TextData[{
 "6. Para demonstrar a evolu\[CCedilla]\[ATilde]o temporal da posi\[CCedilla]\
\[ATilde]o e orienta\[CCedilla]\[ATilde]o do rob\[OHat], plote os \
gr\[AAcute]ficos que relaciona o \[OpenCurlyDoubleQuote]",
 StyleBox["tempo",
  FontSlant->"Italic"],
 " x ",
 StyleBox["x",
  FontSlant->"Italic"],
 "\[CloseCurlyDoubleQuote] e o \[OpenCurlyDoubleQuote]",
 StyleBox["tempo",
  FontSlant->"Italic"],
 " x ",
 StyleBox["y",
  FontSlant->"Italic"],
 "\[CloseCurlyDoubleQuote], o \[OpenCurlyDoubleQuote]",
 StyleBox["tempo",
  FontSlant->"Italic"],
 " x ",
 StyleBox["\[Psi]",
  FontSlant->"Italic"],
 "\[CloseCurlyDoubleQuote].\n7. Para demonstrar a navega\[CCedilla]\[ATilde]o \
do rob\[OHat] no plano cartesiano, plote o gr\[AAcute]fico que relaciona ",
 StyleBox["x",
  FontSlant->"Italic"],
 " e ",
 StyleBox["y",
  FontSlant->"Italic"],
 ".\n8. Informe numericamente a posi\[CCedilla]\[ATilde]o final do rob\[OHat] \
ao final do experimento."
}], "Text",
 CellChangeTimes->{{3.985074113725297*^9, 3.985074116264762*^9}},
 FontFamily->
  "Bookman Old Style",ExpressionUUID->"1ac58901-25f5-4b78-bb7b-08cc7da7243f"]
}, Open  ]],

