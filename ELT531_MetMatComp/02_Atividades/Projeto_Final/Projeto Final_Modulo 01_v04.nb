Cell[BoxData[
 RowBox[{
  RowBox[{"tMeanDataSet", " ", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"\[CapitalDelta]t", "[", "n", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "2", ",", 
       RowBox[{"Length", "[", "time", "]"}]}], "}"}]}], "]"}]}], 
  ";"}]], "Input",
