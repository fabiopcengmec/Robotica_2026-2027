Cell[CellGroupData[{

Cell["Prologue", "Subsection",
 CellChangeTimes->{{3.985668441957676*^9, 3.985668445061054*^9}},
 FontFamily->"Bookman Old Style",
 FontSize->14,ExpressionUUID->"e437a16f-accb-9341-9937-6e5e417a8047"],

Cell[TextData[{
 "Considering two wheels with ",
 StyleBox["r",
  FontSlant->"Italic"],
 " = ",
 StyleBox["rR",
  FontSlant->"Italic"],
 " = ",
 StyleBox["rL = 0,1 meters",
  FontSlant->"Italic"],
 " and ",
 "the distance \[OpenCurlyDoubleQuote]",
 StyleBox["d",
  FontSlant->"Italic"],
 "\[CloseCurlyDoubleQuote] between the wheels being ",
 StyleBox["0,4 meters",
  FontSlant->"Italic"],
 ", and transfoming the velocity signals  \[OpenCurlyDoubleQuote]",
 StyleBox["\[Omega]R\[CloseCurlyDoubleQuote] ",
  FontSlant->"Italic"],
 "and \[OpenCurlyDoubleQuote]",
 StyleBox["\[Omega]L\[CloseCurlyDoubleQuote]",
  FontSlant->"Italic"],
 " into control signals \[OpenCurlyDoubleQuote]",
 StyleBox["u\[CloseCurlyDoubleQuote]",
  FontSlant->"Italic"],
 " and \[OpenCurlyDoubleQuote]",
 StyleBox["\[Omega]\[CloseCurlyDoubleQuote]",
  FontSlant->"Italic"],
 ", it follows that:"
}], "Text",
 CellChangeTimes->{{3.9854497361696415`*^9, 3.9854497602080708`*^9}, {
  3.985452661264929*^9, 3.9854528412424583`*^9}, {3.9854529565535297`*^9, 
  3.985453019876154*^9}},
 FontFamily->
  "Bookman Old Style",ExpressionUUID->"6c6abea3-a775-5f47-b649-c131095a3e4f"],

Cell["\<\
uvelocity[n_, dataset_, ratio_] := ratio ((dataset[[1, n]] + dataset[[2, \
n]])/2)\
\>", "Text",
 CellChangeTimes->{{3.985293491854433*^9, 3.9852935060111465`*^9}, {
   3.9852935740421677`*^9, 3.9852935879651184`*^9}, 3.9852950432124805`*^9, {
   3.985429639488228*^9, 3.9854296426564207`*^9}, {3.985429729329461*^9, 
   3.985429791315404*^9}, {3.9854300781788273`*^9, 3.9854300921116247`*^9}, {
   3.985432253365108*^9, 3.985432276278232*^9}, {3.985432978943121*^9, 
   3.985432993979656*^9}, {3.9854331451154633`*^9, 3.985433153703175*^9}, {
   3.9854331933985243`*^9, 3.985433205532921*^9}, 3.985433484642538*^9},
 TextAlignment->Center,
 FontFamily->"Bookman Old Style",
 FontWeight->"Normal",ExpressionUUID->"05818b89-e526-4755-8862-05613cf00f6e"],

Cell["\<\
\[Omega]velocity[n_, dataset_, ratio_, distance_] := ratio ((dataset[[1, n]] \
- dataset[[2, n]])/distance)\
\>", "Text",
 CellChangeTimes->{{3.985293491854433*^9, 3.9852935060111465`*^9}, {
   3.9852935740421677`*^9, 3.9852935879651184`*^9}, 3.9852950432124805`*^9, {
   3.985429639488228*^9, 3.9854296426564207`*^9}, {3.985429729329461*^9, 
   3.9854298326555643`*^9}, {3.985430082304597*^9, 3.985430093531322*^9}, {
