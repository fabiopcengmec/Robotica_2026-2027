Cell[BoxData[
 RowBox[{"GrafTimeVariation", "=", 
  RowBox[{"ListPlot", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"tMeanDataSet", ",", "AverRefTimeInterval"}], "}"}], ",", 
    RowBox[{"Joined", "->", "True"}], ",", 
    RowBox[{"PlotRange", "->", "All"}], ",", 
    RowBox[{"GridLines", "->", "Automatic"}], ",", 
    RowBox[{"AxesLabel", "->", 
