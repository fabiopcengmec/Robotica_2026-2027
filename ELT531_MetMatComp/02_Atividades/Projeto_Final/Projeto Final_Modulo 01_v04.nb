Cell[TextData[{
 "7. Para demonstrar a navega\[CCedilla]\[ATilde]o do rob\[OHat] no plano \
cartesiano, plote o gr\[AAcute]fico que relaciona ",
 StyleBox["x",
  FontSlant->"Italic"],
 " e ",
 StyleBox["y",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.985074113725297*^9, 3.985074116264762*^9}, {
  3.985086418455532*^9, 3.985086421122452*^9}},
 FontFamily->
