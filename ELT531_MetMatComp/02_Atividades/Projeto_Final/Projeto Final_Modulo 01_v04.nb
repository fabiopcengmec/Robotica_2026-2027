Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{"\[Psi]v2", "[", 
    RowBox[{"time_", ",", "psiinicial_"}], "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"t", "=", "time"}], ",", 
       RowBox[{"psi0", "=", "psiinicial"}], ",", " ", 
       RowBox[{"sollist", "=", 
        RowBox[{"{", 
         RowBox[{"{", 
          RowBox[{"0", ",", "psi0"}], "}"}], "}"}]}], ",", 
       RowBox[{"omega", "=", 
        RowBox[{"\[Omega]signal", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ",", "psitemp", ",", 
       RowBox[{"nold", "=", "1"}], ",", "nnew", ",", "psiFin", ",", "steps"}],
       "}"}], ",", "\n", 
     RowBox[{
      RowBox[{"steps", " ", "=", " ", 
       RowBox[{
        RowBox[{"Length", "[", "t", "]"}], "-", "1"}]}], ";", "\n", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"nnew", "=", 
          RowBox[{"nold", "+", "1"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"psitemp", " ", "=", " ", 
          RowBox[{
           RowBox[{"sollist", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"nnew", "-", "1"}], ",", "2"}], "]"}], "]"}], "+", 
           RowBox[{
            RowBox[{"omega", "[", 
             RowBox[{"[", "nnew", "]"}], "]"}], " ", 
            RowBox[{"\[CapitalDelta]t", "[", "nnew", "]"}]}]}]}], ";", "\n", 
         RowBox[{"sollist", " ", "=", " ", 
          RowBox[{"Append", "[", 
           RowBox[{"sollist", ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"t", "[", 
               RowBox[{"[", "nold", "]"}], "]"}], ",", "psitemp"}], "}"}]}], 
           "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"nold", "=", "nnew"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"nnew", "=", "steps"}], "}"}]}], "]"}], ";", "\n", 
      RowBox[{"Return", "[", "sollist", "]"}]}]}], "]"}]}], "*)"}]], "Input",
