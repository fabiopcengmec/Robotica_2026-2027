Cell[TextData[{
 "4. Para demonstrar a evolu\[CCedilla]\[ATilde]o temporal dos sinais de \
controle do rob\[OHat], plote os gr\[AAcute]ficos que relacionam o \
\[OpenCurlyDoubleQuote]",
 StyleBox["tempo ",
  FontSlant->"Italic"],
 "x",
 StyleBox[" u",
  FontSlant->"Italic"],
 "\[CloseCurlyDoubleQuote] e o \[OpenCurlyDoubleQuote]",
 StyleBox["tempo",
  FontSlant->"Italic"],
 " x ",
 StyleBox["\[Omega]",
  FontSlant->"Italic"],
 "\[CloseCurlyDoubleQuote]."
}], "Text",
 CellChangeTimes->{
  3.9850327750489693`*^9, {3.985032898384186*^9, 3.9850331742723236`*^9}, {
   3.985033240289135*^9, 3.985033261624113*^9}, {3.9850337596483383`*^9, 
   3.985033776864916*^9}, {3.9850340355051765`*^9, 3.9850340419921265`*^9}, 
   3.985074051618252*^9, 3.9850797015247307`*^9, {3.98508635714207*^9, 
   3.9850863577419453`*^9}},
 FontFamily->"Bookman Old Style",
 FontWeight->"Light",ExpressionUUID->"45a7207b-a2a6-429b-8b38-578cbbf11605"],

Cell["\<\
5. Use o modelo cinem\[AAcute]tico, para determinar a \
posi\[CCedilla]\[ATilde]o e orienta\[CCedilla]\[ATilde]o do rob\[OHat] ao \
longo do tempo. A t\[IAcute]tulo de exemplo, para determinar a orienta\
\[CCedilla]\[ATilde]o do rob\[OHat], fa\[CCedilla]a: \
\>", "Text",
 CellChangeTimes->{
  3.9850332878540154`*^9, {3.9850333320733185`*^9, 3.9850334311072197`*^9}, {
   3.985033791177353*^9, 3.98503379204274*^9}},
 FontFamily->"Bookman Old Style",
 FontWeight->"Light",ExpressionUUID->"ab91740e-73c2-41a6-96aa-f6b657f998c3"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   OverscriptBox["\[Psi]", "."], TraditionalForm]],
  FontSlant->"Italic",ExpressionUUID->"5b44f888-155c-4056-88c4-6ac900ba6146"],
 StyleBox["(k) = [\[Psi](k) \[Minus] \[Psi](k\[Minus]1)]/\[CapitalDelta]t = \
\[Omega]",
  FontSlant->"Italic"],
 " , "
}], "Text",
 CellChangeTimes->{
  3.9850332878540154`*^9, {3.9850333320733185`*^9, 3.985033437258486*^9}},
 TextAlignment->Center,
 FontFamily->"Bookman Old Style",
 FontWeight->"Light",ExpressionUUID->"44631b8a-641b-4841-a7fc-8d70d87fb8d0"],

Cell["ou ainda:", "Text",
 CellChangeTimes->{
  3.9850332878540154`*^9, {3.9850333320733185`*^9, 3.9850334298793373`*^9}, {
   3.985033661256199*^9, 3.9850336700076466`*^9}, {3.9850337032317295`*^9, 
   3.9850337290472317`*^9}},
 FontFamily->"Bookman Old Style",
 FontWeight->"Light",ExpressionUUID->"2a3a3859-f545-418e-af10-2f286d65d5d4"],

Cell[TextData[{
 StyleBox["\[Psi](k) = \[Psi](k\[AliasDelimiter]1\t\
qa\[AliasDelimiter]\[Minus]1) + \[Omega]\[CapitalDelta]t",
  FontSlant->"Italic"],
 " ."
}], "Text",
 CellChangeTimes->{
  3.9850332878540154`*^9, {3.9850333320733185`*^9, 3.9850334298793373`*^9}, {
