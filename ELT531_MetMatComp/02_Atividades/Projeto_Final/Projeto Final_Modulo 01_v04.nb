Cell[TextData[{
 "2. Para demonstrar a evolu\[CCedilla]\[ATilde]o temporal das velocidades \
das rodas, plote os gr\[AAcute]ficos que relaciona o \[OpenCurlyDoubleQuote]",
 StyleBox["tempo ",
  FontSlant->"Italic"],
 "x",
 StyleBox[" \[Omega]R",
  FontSlant->"Italic"],
 "\[CloseCurlyDoubleQuote] e o \[OpenCurlyDoubleQuote]",
 StyleBox["tempo ",
  FontSlant->"Italic"],
 "x ",
 StyleBox["\[Omega]L",
  FontSlant->"Italic"],
 "\[CloseCurlyDoubleQuote]."
}], "Text",
