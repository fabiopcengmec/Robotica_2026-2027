Cell["\<\
http://faculty.cooper.edu/smyth/TechCompanion/Calc1/Ch08/NumericalIntegration.\
htm
https://www.engquimicasantossp.com.br/2016/03/integracao-numerica-metodo-\
simpson-trapezio.html\
\>", "Text",
 CellChangeTimes->{{3.987014814779394*^9, 
  3.9870148355647793`*^9}},ExpressionUUID->"b78713c8-0d8a-ea40-9a57-\
ca4518703007"],

Cell[BoxData[
 RowBox[{
  RowBox[{"BackRectInt", "[", 
   RowBox[{"dataset_", ",", "initialValues_", ",", "IntervalType_"}], 
   RowBox[{"(*", 
    RowBox[{"\"\<CST\>\"", " ", "or", " ", "\"\<VAR\>\""}], "*)"}], "]"}], ":=", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"dts", "=", "dataset"}], ",", 
      RowBox[{"t0", "=", 
       RowBox[{"initialValues", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ",", 
      RowBox[{"f0", "=", 
       RowBox[{"initialValues", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], ",", 
      RowBox[{"sollist", "=", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"initialValues", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", 
          RowBox[{"initialValues", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], "}"}], "}"}]}], ",", 
      RowBox[{"tf", "=", 
       RowBox[{
        RowBox[{"dataset", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "1"}], "]"}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"-", "1"}], "]"}], "]"}]}], ",", 
      RowBox[{"ff", "=", 
       RowBox[{
        RowBox[{"dataset", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "2"}], "]"}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"-", "1"}], "]"}], "]"}]}], ",", "step", ",", 
      RowBox[{"steps", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Dimensions", "[", "dts", "]"}], "==", "2"}], ",", 
         RowBox[{
          RowBox[{"Length", "[", 
           RowBox[{"dts", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}], "-", "1"}], ",", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Dimensions", "[", "dts", "]"}], "==", "1"}], ",", 
           RowBox[{
            RowBox[{"Length", "[", "dts", "]"}], "-", "1"}], 
           ",", "\"\<Review the dataset\>\""}], "]"}]}], "]"}]}], ",", 
      RowBox[{"n", "=", "2"}], ",", "\[IndentingNewLine]", "tn", ",", "fn", ",",
       "told", ",", "fold", ",", "h", ",", "tnew", ",", "fnew"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"h", "=", 
      RowBox[{"N", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"tf", "-", "t0"}], ")"}], "/", "steps"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"told", "=", "t0"}], ";", "\[IndentingNewLine]", 
     RowBox[{"fold", "=", "f0"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", 
             RowBox[{"Dimensions", "[", "dts", "]"}], "]"}], "==", "1"}], "&&", 
           RowBox[{"IntervalType", "==", "\"\<CST\>\""}]}], ",", 
          RowBox[{"fnew", "=", 
           RowBox[{
            RowBox[{"(", 
             FractionBox[
              RowBox[{
               RowBox[{"dts", "[", 
                RowBox[{"[", 
                 RowBox[{"-", "1"}], "]"}], "]"}], "-", 
               RowBox[{"dts", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], "steps"], ")"}], " ", 
            RowBox[{"Sum", "[", 
             RowBox[{
              RowBox[{"dts", "[", 
               RowBox[{"[", 
                RowBox[{"i", "+", "1"}], "]"}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"i", ",", "1", ",", "steps"}], "}"}]}], "]"}]}]}]}], 
         "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", 
             RowBox[{"Dimensions", "[", "dataset", "]"}], "]"}], "==", "2"}], 
           "&&", 
           RowBox[{"IntervalType", "==", "\"\<CST\>\""}]}], ",", 
          RowBox[{"fnew", "=", 
           RowBox[{
            RowBox[{"(", 
             FractionBox[
              RowBox[{
               RowBox[{"dataset", "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{"-", "1"}], ",", "1"}], "]"}], "]"}], "-", 
               RowBox[{"dataset", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", "1"}], "]"}], "]"}]}], 
              RowBox[{
               RowBox[{"Dimensions", "[", "dataset", "]"}], "[", 
               RowBox[{"[", "1", "]"}], "]"}]], ")"}], " ", 
            RowBox[{"Sum", "[", 
             RowBox[{
              RowBox[{"dataset", "[", 
               RowBox[{"[", 
                RowBox[{
                 RowBox[{"i", "+", "1"}], ",", "2"}], "]"}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"i", ",", "1", ",", "steps"}], "}"}]}], "]"}]}]}]}], 
         "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"tnew", " ", "=", " ", 
         RowBox[{"dts", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{"n", "-", "1"}], ",", "1"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"fnew", " ", "=", " ", 
         RowBox[{
          RowBox[{"sollist", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"n", "-", "1"}], ",", "2"}], "]"}], "]"}], "+", 
          RowBox[{"h", " ", 
           RowBox[{"dts", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"n", "-", "1"}], ",", "2"}], "]"}], "]"}]}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"sollist", "=", 
         RowBox[{"Append", "[", 
          RowBox[{"sollist", ",", 
           RowBox[{"{", 
            RowBox[{"tnew", ",", "fnew"}], "}"}]}], "]"}]}], ";", 
        RowBox[{"(*", 
         RowBox[{"Mounting", " ", "the", " ", "result", " ", "vector"}], 
         "*)"}], "\[IndentingNewLine]", 
        RowBox[{"n", " ", "=", " ", 
         RowBox[{"n", "+", "1"}]}]}], "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"tnew", "=", 
          RowBox[{"told", "+", "h"}]}], ";", 
         RowBox[{"(*", 
          RowBox[{"\"\<FOR\>\"", " ", "to", " ", "Wolfram", " ", "Language"}],
           "*)"}], "\[IndentingNewLine]", 
         RowBox[{"fnew", "=", 
          RowBox[{"fold", "+", 
           RowBox[{"h", "*", 
            RowBox[{"dataset", "[", 
             RowBox[{"[", 
              RowBox[{"n", ",", "2"}], "]"}], "]"}]}]}]}], ";"}], 
        "\[IndentingNewLine]", "*)"}], 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"tnew", "=", "tn"}], ";", 
         RowBox[{"(*", 
          RowBox[{"\"\<FOR\>\"", " ", "to", " ", "Wolfram", " ", "Language"}],
           "*)"}], "\[IndentingNewLine]", 
         RowBox[{"fnew", "=", 
          RowBox[{"fn", "+", 
           RowBox[{"h", "*", 
            RowBox[{"dataset", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"n", "-", "1"}], ",", "2"}], "]"}], "]"}]}]}]}], ";"}],
         "*)"}], "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"told", "=", "tnew"}], ";", "\[IndentingNewLine]", 
         RowBox[{"fold", "=", "fnew"}]}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"tn", "=", "tnew"}], ";", "\[IndentingNewLine]", 
         RowBox[{"fn", "=", "fnew"}]}], "*)"}], ",", 
       RowBox[{"{", "step", "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Return", "[", "sollist", "]"}]}]}], " ", 
   RowBox[{"(*", 
    RowBox[{"to", " ", "see", " ", "all", " ", "grid", " ", "points"}], 
    "*)"}], "]"}]}]], "Input",
